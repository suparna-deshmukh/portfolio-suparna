15:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"AskCart: Guided AI E-Commerce Search and Chatbot\",\"description\":\"A guided follow-up search MVP over 54K Bayesian-rated SKUs that cut null results from 27.3% to 8%, with a RAG chatbot that passes evals at 96.5%.\",\"author\":{\"@type\":\"Person\",\"name\":\"Suparna Deshmukh\"},\"datePublished\":\"2026-08-20T10:00:00+00:00\",\"mainEntityOfPage\":\"http://localhost:3210/projects/askcart\"}"}}],["$","main",null,{"id":"content","className":"ms has-rail","children":[["$","$L20",null,{"minutes":3}],["$","$L21",null,{}],["$","div",null,{"className":"ms-desk","children":[["$","$L22",null,{"items":[{"id":"the-problem","text":"The problem","words":58,"start":0},{"id":"mining-94-600-reviews-for-signal","text":"Mining 94,600 reviews for signal","words":71,"start":334},{"id":"ask-don-t-guess","text":"Ask, don't guess","words":59,"start":740},{"id":"when-the-model-is-the-fallback","text":"When the model is the fallback","words":49,"start":1071},{"id":"evals-before-launch","text":"Evals before launch","words":64,"start":1373},{"id":"what-shipped","text":"What shipped","words":35,"start":1736}],"slug":"askcart","minutes":3}],["$","article",null,{"className":"paper","style":{"viewTransitionName":"post-paper-askcart"},"children":[["$","header",null,{"className":"ms-hd","children":[["$","div",null,{"className":"top","children":[["$","p",null,{"className":"backs","children":[["$","$L23",null,{"className":"back","href":"/#projects","children":["← ","Projects"]}],false]}],["$","p",null,{"className":"kind","children":[["$","b",null,{"children":"Case study"}],[["$","span",null,{"children":"Next.js · SQL · Python · ML · Gemini API"}],"$undefined"],["$","span",null,{"children":[3," min read"]}]]}],["$","h1",null,{"style":{"viewTransitionName":"case-title-askcart"},"children":"AskCart"}],["$","p",null,{"className":"sub","children":"Guided AI E-Commerce Search and Chatbot"}]]}],["$","div",null,{"className":"case-shots","style":{"viewTransitionName":"case-media-askcart"},"children":[["$","figure","/images/projects/askcart-home.webp",{"className":"case-shot","children":[["$","$L24",null,{"src":"/images/projects/askcart-home.webp","alt":"The home: one search, one ask — the guided follow-up replaces the dead end.","width":1280,"height":800,"sizes":"(max-width: 900px) 100vw, 900px","priority":true}],["$","figcaption",null,{"children":[["$","i",null,{"aria-hidden":"true","children":"01"}],"The home: one search, one ask — the guided follow-up replaces the dead end."]}]]}],["$","figure","/images/projects/askcart-guided-v2.webp",{"className":"case-shot","children":[["$","$L24",null,{"src":"/images/projects/askcart-guided-v2.webp","alt":"0 hits is the trigger, not the end: “shaadi gift under 2k” misses, and one tappable follow-up — what kind of item? — replaces the blank page.","width":1200,"height":660,"sizes":"(max-width: 900px) 100vw, 900px","priority":false}],["$","figcaption",null,{"children":[["$","i",null,{"aria-hidden":"true","children":"02"}],"0 hits is the trigger, not the end: “shaadi gift under 2k” misses, and one tappable follow-up — what kind of item? — replaces the blank page."]}]]}],["$","figure","/images/projects/askcart-analytics.webp",{"className":"case-shot","children":[["$","$L24",null,{"src":"/images/projects/askcart-analytics.webp","alt":"Live analytics against the study baseline: null results 8.0% vs 27.3%, 78.7% resolved within two follow-ups.","width":1280,"height":900,"sizes":"(max-width: 900px) 100vw, 900px","priority":false}],["$","figcaption",null,{"children":[["$","i",null,{"aria-hidden":"true","children":"03"}],"Live analytics against the study baseline: null results 8.0% vs 27.3%, 78.7% resolved within two follow-ups."]}]]}]]}],["$","aside",null,{"className":"hnotes","aria-label":"Margin notes","style":{"viewTransitionName":"post-notes-askcart"},"children":[["$","div"