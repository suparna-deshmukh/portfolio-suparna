me":"hnotes","aria-label":"Margin notes","style":{"viewTransitionName":"post-notes-research-agent"},"children":[["$","div",null,{"className":"hn","children":[["$","svg",null,{"viewBox":"0 0 28 18","aria-hidden":"true","children":["$","path",null,{"d":"M26 14 C 20 4, 12 4, 3 9 M7 5 L3 9 L8 11"}]}],["$","b",null,{"children":"Pull quote"}],["$","p",null,{"children":["I wanted that loop to ",["$","mark",null,{"children":"run itself"}]," — give it a topic, get back a prioritized pile of pain points and a first draft of the work."]}]]}],[["$","div","The scale",{"className":"hn","children":["$6",["$","b",null,{"children":"The scale"}],["$","p",null,{"children":"aggregates 500+ pain points per run"}],["$","a",null,{"href":"#the-28-node-workflow","children":["Read it in ","The 28-node workflow"," ↓"]}]]}],["$","div","The payoff",{"className":"hn","children":["$6",["$","b",null,{"children":"The payoff"}],["$","p",null,{"children":"research-to-spec time dropped by 70%"}],["$","a",null,{"href":"#from-pain-points-to-prd","children":["Read it in ","From pain points to PRD"," ↓"]}]]}],["$","div","The blind spot",{"className":"hn","children":["$6",["$","b",null,{"children":"The blind spot"}],["$","p",null,{"children":"it's worse at knowing what it doesn't know"}],["$","a",null,{"href":"#what-i-d-change","children":["Read it in ","What I'd change"," ↓"]}]]}]]]}]]}],["$","div",null,{"className":"ms-body","children":["$","div",null,{"className":"prose","children":[["$","h2",null,{"id":"why-i-built-it","children":"Why I built it"}],"\n",["$","div",null,{"className":"mp","children":[["$","p",null,{"children":["As a PM I kept doing the same thing by hand: reading threads, noting complaints, finding the pattern, drafting the spec. I wanted that loop to ",["$","mark","0",{"className":"mk","children":"run itself"}]," — give it a topic, get back a prioritized pile of pain points and a first draft of the work."]}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","pq",{"className":"mnote","children":["$6",["$","b",null,{"children":"Pull quote"}],["$","small",null,{"children":"Select any line to reply"}]]}]]}]]}],"\n",["$","h2",null,{"id":"the-28-node-workflow","children":"The 28-node workflow"}],"\n",["$","div",null,{"className":"mp","children":[["$","p",null,{"children":"The agent is a 28-node n8n workflow with auto subreddit discovery. From a topic input it scrapes Reddit and Hacker News via their APIs, aggregates 500+ pain points per run, and hands them to an LLM pipeline on Ollama (Llama 3) that classifies feedback by theme, flags competitor mentions and generates PRDs and user stories."}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","The scale",{"className":"mnote","children":["$6",["$","b",null,{"children":"The scale"}],["$","i",null,{"children":"aggregates 500+ pain points per run"}]]}]]}]]}],"\n",["$","h2",null,{"id":"from-pain-points-to-prd","children":"From pain points to PRD"}],"\n",["$","div",null,{"className":"mp","children":[["$","p",null,{"children":"The output is a ranked theme list with quotes attached, then a PRD skeleton: problem statement, affected users, proposed solution and open questions. For a new product area, research-to-spec time dropped by 70% versus doing it by hand."}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","The payoff",{"className":"mnote","children":["$6",["$","b",null,{"children":"The payoff"}],["$","i",null,{"children":"research-to-spec time dropped by 70%"}]]}]]}]]}],"\n",["$","h2",null,{"id":"scheduled-not-one-shot","children":"Scheduled, not one-shot"}],"\n",["$","p",null,{"children":["It runs on a schedule with a form-based UI, keyword expansion and history logging, so last week's themes and this week's themes are diffable. ",["$","mark","0",{"className":"mk","children":"The history log is the part I use most — trends are visible only across runs."}]]}],"\n",["$","h2",null,{"id":"what-i-d-change","children":"What I'd change"}],"\n",["$","div",null,{"className":"mp","children":[["$","p",null,{"children":"I'd add citations back into every generated claim, and I'd make the theme taxonomy a human-editable artifact instead of a prompt. The LLM is good at drafting; it's worse at knowing what it doesn't know."}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","The blind spot",{"className":"mnote","children":["$6",["$","b",null,{"children":"The blind spot"}],["$","i",null,{"children":"it's worse at knowing what it doesn't know"}]]}]]}]]}]]}]}]]}]]}],["$","div",null,{"className":"enddesk an","children":[["$","$La",null,{"heading":"Questions about how Research Agent was built?","title":"Research Agent","quote":"I wanted that loop to run itself — give it a topic, get back a prioritized pile of pain points and a first draft of the work."}],["$","aside",null,{"className":"rail","aria-label":"Next on the desk","children":[["$","p",null,{"className":"rl","children":[["$","span",null,{"children":"Next on the desk"}],["$","i",null,{"children":[1," ","page"]}]]}],["$","div",null,{"className":"pile","style":{"--n":1},"children":[["$","$L5",null,{"href":"/projects/askcart","className":"pg","style":{"--k":0,"--r":"0.8deg","viewTransitionName":"post-paper-askcart"},"children":[["$","p",null,{"className":"pm","children":[["$","b",null,{"children":"Case study"}]," · 3 min read"]}],["$","h3",null,{"children":"AskCart"}],["$","div",null,{"className":"sw","children":[["$","p",null,{"className":"dk","children":"Guided AI E-Commerce Search and Chatbot"}],["$","p",null,{"className":"pq","children":["“","When the catalog returns nothing, the shopper doesn't file a ticket — they just leave.","”"]}]]}]]}]]}]]}]]}],["$","footer",null,{"className":"foot","children":["$","div",null,{"className":"links","children":[["$","$Lb",null,{}],["$","span",null,{"children":["© ",2026," Suparna Deshmukh"]}]]}]}]]}],null],null],null]},[null,["$","$Lc",null,{"parallelRouterKey":"children","segmentPath":["