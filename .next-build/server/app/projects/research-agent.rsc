2a:["$","p","p-3",{"children":["It runs on a schedule with a form-based UI, keyword expansion and history logging, so last week's themes and this week's themes are diffable. ",["$","mark","0",{"className":"mk","children":"The history log is the part I use most — trends are visible only across runs."}]]}]
2b:["$","h2","h2-4",{"id":"what-i-d-change","children":"What I'd change"}]
2c:["$","div","p-4",{"className":"mp","children":[["$","p",null,{"children":"I'd add citations back into every generated claim, and I'd make the theme taxonomy a human-editable artifact instead of a prompt. The LLM is good at drafting; it's worse at knowing what it doesn't know."}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","The blind spot",{"className":"mnote","children":["$15:1:props:children:2:props:children:1:props:children:0:props:children:2:props:children:0:props:children:0",["$","b",null,{"children":"The blind spot"}],["$","i",null,{"children":"it's worse at knowing what it doesn't know"}]]}]]}]]}]
