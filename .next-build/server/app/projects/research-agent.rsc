26:["$","div","p-1",{"className":"mp","children":[["$","p",null,{"children":"The agent is a 28-node n8n workflow with auto subreddit discovery. From a topic input it scrapes Reddit and Hacker News via their APIs, aggregates 500+ pain points per run, and hands them to an LLM pipeline on Ollama (Llama 3) that classifies feedback by theme, flags competitor mentions and generates PRDs and user stories."}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","The scale",{"className":"mnote","children":["$15:1:props:children:2:props:children:1:props:children:0:props:children:2:props:children:0:props:children:0",["$","b",null,{"children":"The scale"}],["$","i",null,{"children":"aggregates 500+ pain points per run"}]]}]]}]]}]
27:["$","h2","h2-2",{"id":"from-pain-points-to-prd","children":"From pain points to PRD"}]
28:["$","div","p-2",{"className":"mp","children":[["$","p",null,{"children":"The output is a ranked theme list with quotes attached, then a PRD skeleton: problem statement, affected users, proposed solution and open questions. For a new product area, research-to-spec time dropped by 70% versus doing it by hand."}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","The payoff",{"className":"mnote","children":["$15:1:props:children:2:props:children:1:props:children:0:props:children:2:props:children:0:props:children:0",["$","b",null,{"children":"The payoff"}],["$","i",null,{"children":"research-to-spec time dropped by 70%"}]]}]]}]]}]
