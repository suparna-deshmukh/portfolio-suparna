15:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Insight Extractor: Agentic User Insight Engine\",\"description\":\"A Gemini-planned research agent: one brief in, eight live platforms tapped in parallel, signal bucketed by LLM + SQL, and a fixed-format User Insights Report out — on a strict ≤3 Gemini-calls-per-run budget.\",\"author\":{\"@type\":\"Person\",\"name\":\"Suparna Deshmukh\"},\"datePublished\":\"2026-08-18T10:00:00+00:00\",\"mainEntityOfPage\":\"http://localhost:3210/projects/insight-extractor\"}"}}],["$","main",null,{"id":"content","className":"ms has-rail","children":[["$","$L20",null,{"minutes":3}],["$","$L21",null,{}],["$","div",null,{"className":"ms-desk","children":[["$","$L22",null,{"items":[{"id":"why","text":"Why","words":37,"start":0},{"id":"the-mechanism","text":"The mechanism","words":88,"start":184},{"id":"budget-and-guardrails","text":"Budget and guardrails","words":71,"start":782},{"id":"modes","text":"Modes","words":36,"start":1212},{"id":"where-it-runs","text":"Where it runs","words":41,"start":1418}],"slug":"insight-extractor","minutes":3}],["$","article",null,{"className":"paper","style":{"viewTransitionName":"post-paper-insight-extractor"},"children":[["$","header",null,{"className":"ms-hd","children":[["$","div",null,{"className":"top","children":[["$","p",null,{"className":"backs","children":[["$","$L23",null,{"className":"back","href":"/#projects","children":["← ","Projects"]}],false]}],["$","p",null,{"className":"kind","children":[["$","b",null,{"children":"Case study"}],[["$","span",null,{"children":"Next.js · TypeScript · Gemini · LLM agents · REST APIs"}],"$undefined"],["$","span",null,{"children":[3," min read"]}]]}],["$","h1",null,{"style":{"viewTransitionName":"case-title-insight-extractor"},"children":"Insight Extractor"}],["$","p",null,{"className":"sub","children":"Agentic User Insight Engine"}]]}],["$","div",