iv",null,{"className":"prose","children":[["$","h2","h2-0",{"id":"why-reviews","children":"Why reviews"}],"\n",["$","div","p-0",{"className":"mp","children":[["$","p",null,{"children":"E-commerce search fails silently, and the fix lives in the only dataset that will tell you why: reviews. People don't file tickets for a dead-end search, but they do review the app that failed them."}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","The dataset",{"className":"mnote","children":["$15:1:props:children:2:props:children:1:props:children:0:props:children:2:props:children:0:props:children:0",["$","b",null,{"children":"The dataset"}],["$","i",null,{"children":"the only dataset that will tell you why: reviews"}]]}]]}]]}],"\n",["$","h2","h2-1",{"id":"the-mechanism","children":"The mechanism"}],"\n",["$","div","p-1",{"className":"mp","children":[["$","p",null,{"children":"I built an agentic extractor on the Reddit, App Store and Play Store APIs that pulls raw review text at scale, then a 6-stage SQL pipeline that cleans, deduplicates and tags it. Across 94.6K reviews the pipeline isolates the root causes of search failure instead of one fuzzy complaint category."}],"$L25"]}],"\n","$L26","\n","$L27","\n","$L28","\n","$L29"]}]}]]}]]}],"$L2a","$L2b"]}]]
