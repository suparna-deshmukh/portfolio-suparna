27:["$","div","p-2",{"className":"mp","children":[["$","p",null,{"children":["The mining surfaced four causes: vague intent, missing filter context, spelling and slang drift, and catalog gaps that no query could ever fix. ",["$","mark","0",{"className":"mk","children":"Each cause got its own treatment instead of one generic \"no results\" page."}]]}],["$","div",null,{"className":"mnotes","role":"note","children":[["$","span","pq",{"className":"mnote","children":["$15:1:props:children:2:props:children:1:props:children:0:props:children:2:props:children:0:props:children:0",["$","b",null,{"children":"Pull quote"}],["$","small",null,{"children":"Select any line to reply"}]]}]]}]]}]
