# Portfolio env template. Copy to .env.local and fill in what applies to your deployment.

# Suparna's professional email address (brief Section 7, item 4). Until set, the site shows
# no email at all — the contact form still works and the API falls back server-side.
#NEXT_PUBLIC_CONTACT_EMAIL=

# Resend API key for the contact form (brief P0-5). Without it the API returns a clean
# typed error instead of sending.
#RESEND_API_KEY=
